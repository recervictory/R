library(Seurat)

# Function to update metadata values in Seurat object
update_seurat_metadata <- function(seurat_obj, old_column, new_column = "PBTA_Annotation", mapping) {
  # Check if the old column exists in the Seurat object's metadata
  if (!old_column %in% colnames(seurat_obj@meta.data)) {
    stop(paste("Column", old_column, "not found in metadata"))
  }
  
  # Create a new column in the metadata with mapped values
  seurat_obj[[new_column]] <- seurat_obj@meta.data[[old_column]]
  
  # Apply the mapping to the new column
  seurat_obj@meta.data[[new_column]] <- sapply(seurat_obj@meta.data[[new_column]], function(x) {
    if (x %in% names(mapping)) {
      return(mapping[x])
    } else {
      return(x)  # Return original value if no mapping exists
    }
  })
  
  # Return the updated Seurat object
  return(seurat_obj)
}
